{
  "version": "1.0",
  "description": "评估系统统一配置文件",

  "scoring": {
    "default_weights": {
      "retrieval_weight": 0.35,
      "content_weight": 0.55,
      "citation_weight": 0.10,
      "tool_weight": 0.0
    },
    "category_weights": {
      "understanding": {
        "retrieval_weight": 0.30,
        "content_weight": 0.60,
        "citation_weight": 0.10
      },
      "reasoning": {
        "retrieval_weight": 0.40,
        "content_weight": 0.50,
        "citation_weight": 0.10
      },
      "statistics": {
        "retrieval_weight": 0.15,
        "content_weight": 0.75,
        "citation_weight": 0.10
      },
      "negative": {
        "retrieval_weight": 0.25,
        "content_weight": 0.65,
        "citation_weight": 0.10
      },
      "skill": {
        "retrieval_weight": 0.20,
        "content_weight": 0.70,
        "citation_weight": 0.10
      },
      "web_search": {
        "retrieval_weight": 0.1,
        "content_weight": 0.7,
        "citation_weight": 0.2
      }
    }
  },

  "synonyms": {
    "global": {
      "时间复杂度": ["time complexity", "时间开销", "运行时间"],
      "空间复杂度": ["space complexity", "内存占用", "空间开销"],
      "动态规划": ["DP", "dynamic programming", "状态转移"],
      "广度优先": ["BFS", "breadth-first", "层序遍历"],
      "深度优先": ["DFS", "depth-first"],
      "二分查找": ["binary search", "二分搜索", "bisect"],
      "连通分量": ["connected component", "连通块"],
      "队列": ["queue", "deque"],
      "栈": ["stack"],
      "哈希表": ["hash table", "hashmap", "dict", "dictionary"],
      "并查集": ["union find", "disjoint set"],
      "记忆化": ["memoization", "memo", "缓存"],
      "回溯": ["backtrack", "backtracking"],
      "贪心": ["greedy"],
      "滑动窗口": ["sliding window"]
    }
  },

  "semantic_categories": {
    "negation": ["没有", "未找到", "不存在", "无", "未", "不含", "缺少", "尚无", "暂无", "未发现", "找不到"],
    "existence": ["有", "存在", "包含", "含有", "记录了", "提及", "涉及"],
    "uncertainty": ["不确定", "可能", "也许", "大概", "似乎"]
  },

  "thresholds": {
    "pass_thresholds": {
      "understanding": 0.7,
      "reasoning": 0.65,
      "negative": 0.8,
      "statistics": 0.7,
      "skill": 0.7,
      "web_search": 0.6,
      "multi_turn": 0.7,
      "default": 0.7
    },
    "perfect_score_threshold": 1.0,
    "semantic_similarity_threshold": 0.75,
    "semantic_match_weight": 0.7
  },

  "recall": {
    "k_values": [1, 3, 5, 10],
    "k_for_scoring": 5,
    "use_chunk_level": false
  },

  "tool_evaluation": {
    "redundancy_penalty_rate": 0.2,
    "order_violation_max_penalty": 0.3
  },

  "unknown_detection": {
    "patterns": [
      "未知",
      "不知道",
      "无法确定",
      "无相关信息",
      "文档未覆盖",
      "没有.*信息",
      "未提及",
      "没有.*相关",
      "笔记.*没有",
      "未找到",
      "无法回答"
    ],
    "exclusion_patterns": [
      "虽然.*但",
      "虽然.*不过",
      "虽然没有.*可以",
      "虽然未.*但",
      "如果你允许.*补充",
      "用通用知识补充",
      "不限于笔记"
    ],
    "lazy_rejection_penalty": 0.5
  }
}
