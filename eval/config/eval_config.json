{
  "version": "1.0",
  "description": "评估系统统一配置文件",

  "scoring": {
    "default_weights": {
      "retrieval_weight": 0.3,
      "content_weight": 0.5,
      "citation_weight": 0.2,
      "tool_weight": 0.0
    },
    "category_weights": {
      "reasoning": {
        "retrieval_weight": 0.4,
        "content_weight": 0.4,
        "citation_weight": 0.2
      },
      "statistics": {
        "retrieval_weight": 0.2,
        "content_weight": 0.6,
        "citation_weight": 0.2
      },
      "negative": {
        "retrieval_weight": 0.2,
        "content_weight": 0.6,
        "citation_weight": 0.2
      },
      "web_search": {
        "retrieval_weight": 0.1,
        "content_weight": 0.7,
        "citation_weight": 0.2
      }
    }
  },

  "thresholds": {
    "pass_thresholds": {
      "understanding": 0.7,
      "reasoning": 0.65,
      "negative": 0.8,
      "statistics": 0.7,
      "skill": 0.7,
      "web_search": 0.6,
      "multi_turn": 0.7,
      "default": 0.7
    },
    "perfect_score_threshold": 1.0,
    "semantic_similarity_threshold": 0.75,
    "semantic_match_weight": 0.7
  },

  "recall": {
    "k_values": [1, 3, 5, 10],
    "k_for_scoring": 5,
    "use_chunk_level": false
  },

  "tool_evaluation": {
    "redundancy_penalty_rate": 0.2,
    "order_violation_max_penalty": 0.3
  },

  "unknown_detection": {
    "patterns": [
      "未知",
      "不知道",
      "无法确定",
      "无相关信息",
      "文档未覆盖",
      "没有.*信息",
      "未提及",
      "没有.*相关",
      "笔记.*没有",
      "未找到",
      "无法回答"
    ],
    "exclusion_patterns": [
      "虽然.*但",
      "虽然.*不过",
      "虽然没有.*可以",
      "虽然未.*但",
      "如果你允许.*补充",
      "用通用知识补充",
      "不限于笔记"
    ],
    "lazy_rejection_penalty": 0.5
  }
}
