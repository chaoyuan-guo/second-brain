{
  "$schema": "https://opencode.ai/config.json",
  "model": "azure/gpt-5.4-low",
  "agent": {
    "build": {
      "mode": "primary",
      "prompt": "{file:../AGENTS.md}",
      "steps": 14
    }
  },
  "provider": {
    "aibuilder": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AI Builder",
      "options": {
        "baseURL": "{env:SUPER_MIND_API_BASE_URL}",
        "apiKey": "{env:AI_BUILDER_TOKEN}",
        "compatibility": "compatible"
      },
      "models": {
        "deepseek": {
          "name": "deepseek",
          "reasoning": false,
          "tool_call": true,
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "gpt-5": {
          "name": "gpt-5",
          "reasoning": false,
          "tool_call": true
        },
        "kimi-k2.5": {
          "name": "kimi-k2.5",
          "reasoning": true,
          "tool_call": true,
          "interleaved": {
            "field": "reasoning_content"
          }
        }
      }
    },
    "azure": {
      "npm": "@ai-sdk/openai",
      "name": "Azure OpenAI (v1)",
      "options": {
        "baseURL": "{env:OPENCODE_AZURE_BASE_URL}",
        "apiKey": "{env:azure_api_key}"
      },
      "models": {
        "gpt-5.4": {
          "name": "gpt-5.4"
        },
        "gpt-5.4-low": {
          "id": "gpt-5.4",
          "name": "gpt-5.4",
          "options": {
            "reasoningEffort": "low",
            "reasoningSummary": null
          }
        }
      }
    }
  }
  // 第二阶段再按需打开 mcp 配置：
  // "mcp": {
  //   "rag-server": {
  //     "type": "sse",
  //     "url": "http://127.0.0.1:9070/sse"
  //   }
  // }
}
