{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "azure": {
      "npm": "@ai-sdk/azure",
      "name": "Azure OpenAI",
      "options": {
        "baseURL": "{env:azure_base_url}",
        "apiKey": "{env:azure_api_key}",
        "apiVersion": "{env:azure_api_version}"
      },
      "models": {
        "gpt-52": {
          "name": "GPT-5.2"
        }
      }
    }
  }
  // 第二阶段再按需打开 mcp 配置：
  // "mcp": {
  //   "rag-server": {
  //     "type": "sse",
  //     "url": "http://127.0.0.1:9070/sse"
  //   }
  // }
}

