{
  "$schema": "https://opencode.ai/config.json",
  "model": "azure/gpt-52",
  "provider": {
    "aibuilder": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "AI Builder",
      "options": {
        "baseURL": "{env:SUPER_MIND_API_BASE_URL}",
        "apiKey": "{env:AI_BUILDER_TOKEN}",
        "compatibility": "compatible"
      },
      "models": {
        "deepseek": {
          "name": "deepseek",
          "limit": {
            "context": 65536,
            "output": 8192
          }
        },
        "gpt-5": {
          "name": "gpt-5"
        }
      }
    },
    "azure": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Azure OpenAI (Compatible)",
      "options": {
        "baseURL": "{env:OPENCODE_AZURE_BASE_URL}",
        "apiKey": "{env:azure_api_key}",
        "compatibility": "compatible"
      },
      "models": {
        "gpt-52": {
          "name": "gpt-52"
        }
      }
    }
  }
  // 第二阶段再按需打开 mcp 配置：
  // "mcp": {
  //   "rag-server": {
  //     "type": "sse",
  //     "url": "http://127.0.0.1:9070/sse"
  //   }
  // }
}
